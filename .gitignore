
.env
.env.*
!.env.example
*.salt
*.pem
*.key
credentials.json
kaggle.json
secrets.yaml
aws_credentials

# ---------------------------------------------------------------------------
# DATA — never commit anything containing real customer records.
# Raw Mongo exports, extracted tables, and training sets all live here and are
# regenerated by the pipeline, so there is no reason to track them.
# ---------------------------------------------------------------------------
data/
!data/.gitkeep

# Belt and braces: catch data files written outside data/ by mistake.
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# CSV/JSON are ignored broadly because exports and chargeback sheets use them.
# Small tracked files are re-included by the negations below.
*.csv
*.tsv
*.json
*.jsonl
*.ndjson

# --- re-include small, safe files that happen to be CSV/JSON -----------------
!requirements*.json
!package.json
!package-lock.json
!tsconfig.json
!.vscode/*.json
# mock/sample fixtures used for testing (verify they contain NO real records)
!samples/**/*.json
!samples/**/*.csv
!tests/fixtures/**/*.json
!tests/fixtures/**/*.csv

# ---------------------------------------------------------------------------
# MODEL ARTIFACTS — regenerated by training; the durable copy belongs in S3.
# optuna.db in particular grows steadily across tuning runs.
# ---------------------------------------------------------------------------
artifacts/
models/
*.joblib
*.onnx
*.bin
optuna.db
optuna*.sqlite3
mlruns/

# ---------------------------------------------------------------------------
# LOGS — produced by setup_logging(); useful locally, noise in git.
# ---------------------------------------------------------------------------
logs/
*.log
*.log.*

# ---------------------------------------------------------------------------
# PYTHON
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# NOTEBOOKS — outputs can embed real data; strip before committing.
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# TESTING / TOOLING
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ---------------------------------------------------------------------------
# EDITORS / OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# INFRASTRUCTURE
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
